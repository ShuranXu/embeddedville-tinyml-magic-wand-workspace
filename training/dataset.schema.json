{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://embeddedville.com/schemas/tinyml-magic-wand-dataset-v1.json",
  "title": "EmbeddedVille TinyML Magic Wand dataset",
  "type": "object",
  "required": ["schemaVersion", "boardProfile", "sessions", "strokes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "boardProfile": { "enum": ["original-lsm9ds1", "rev2-bmi270", "virtual-wand-v1", "fixture"] },
    "sessions": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "label", "split"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "enum": ["wing", "ring", "slope", "unknown"] },
          "split": { "enum": ["train", "validation", "test"] }
        },
        "additionalProperties": false
      }
    },
    "strokes": {
      "type": "array",
      "minItems": 240,
      "items": {
        "type": "object",
        "required": ["id", "label", "sessionId", "points"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "enum": ["wing", "ring", "slope", "unknown"] },
          "sessionId": { "type": "string", "minLength": 1 },
          "points": {
            "type": "array",
            "minItems": 20,
            "maxItems": 160,
            "items": {
              "type": "object",
              "required": ["x", "y", "t"],
              "properties": {
                "x": { "type": "number", "minimum": -1, "maximum": 1 },
                "y": { "type": "number", "minimum": -1, "maximum": 1 },
                "t": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
