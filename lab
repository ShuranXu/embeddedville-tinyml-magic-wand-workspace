#!/usr/bin/env python3
"""EmbeddedVille workspace checks and browser-paired submission."""

from __future__ import annotations

import argparse
import hashlib
import io
import json
import os
from pathlib import Path
import subprocess
import sys
import time
import urllib.error
import urllib.request
import uuid
import zipfile

ROOT = Path(__file__).resolve().parent
CONFIG_PATH = ROOT / ".embeddedville-workspace.json"
FORBIDDEN_DIRS = {".git", ".hg", ".svn", ".cache", "node_modules", "__pycache__", ".pytest_cache", ".mypy_cache", "dist", "build", "out", "private-evaluator", "evaluator-private"}
FORBIDDEN_NAMES = {".env", ".npmrc", ".pypirc", "credentials", "credentials.json", "id_rsa", "id_ed25519"}
FORBIDDEN_SUFFIXES = {".pem", ".key", ".pyc"}


class LabError(RuntimeError):
    pass


def config() -> dict:
    return json.loads(CONFIG_PATH.read_text(encoding="utf-8"))


def run_git(*args: str) -> str | None:
    result = subprocess.run(["git", "-C", str(ROOT), *args], text=True, capture_output=True, check=False)
    return result.stdout.strip() if result.returncode == 0 else None


def selected_files(cfg: dict) -> list[Path]:
    selected: dict[str, Path] = {}
    for entry in cfg["snapshotAllowlist"]:
        candidate = ROOT / entry
        if not candidate.exists():
            continue
        paths = [candidate] if candidate.is_file() or candidate.is_symlink() else candidate.rglob("*")
        for path in paths:
            relative = path.relative_to(ROOT)
            if path.is_symlink():
                raise LabError(f"Symlinks are not allowed in a submission: {relative.as_posix()}")
            if not path.is_file():
                continue
            lowered = [part.lower() for part in relative.parts]
            if any(part in FORBIDDEN_DIRS for part in lowered):
                continue
            name = relative.name.lower()
            if name in FORBIDDEN_NAMES or name.startswith(".env.") or path.suffix.lower() in FORBIDDEN_SUFFIXES:
                raise LabError(f"Credential-like file is not allowed in a submission: {relative.as_posix()}")
            selected[relative.as_posix()] = path
    if not selected:
        raise LabError("The workspace allowlist selected no files.")
    return [selected[key] for key in sorted(selected)]


def snapshot(cfg: dict) -> tuple[dict, bytes]:
    manifest_files: list[dict] = []
    archive_buffer = io.BytesIO()
    with zipfile.ZipFile(archive_buffer, "w", compression=zipfile.ZIP_STORED, strict_timestamps=True) as archive:
        for path in selected_files(cfg):
            relative = path.relative_to(ROOT).as_posix()
            data = path.read_bytes()
            manifest_files.append({"path": relative, "sha256": hashlib.sha256(data).hexdigest(), "bytes": len(data), "type": "file"})
            info = zipfile.ZipInfo(relative, date_time=(2026, 10, 1, 0, 0, 0))
            info.compress_type = zipfile.ZIP_STORED
            info.create_system = 3
            info.external_attr = 0o100644 << 16
            archive.writestr(info, data)
    return {"schemaVersion": 1, "files": manifest_files}, archive_buffer.getvalue()


def canonical_manifest(manifest: dict) -> bytes:
    files = sorted(manifest["files"], key=lambda item: item["path"])
    normalized = {"schemaVersion": 1, "files": [{"path": f["path"], "sha256": f["sha256"], "bytes": f["bytes"], "type": f.get("type", "file")} for f in files]}
    return json.dumps(normalized, ensure_ascii=False, separators=(",", ":")).encode("utf-8")


def request_json(url: str, method: str = "GET", payload: dict | None = None, token: str | None = None, body: bytes | None = None, content_type: str | None = None) -> dict:
    headers = {"Accept": "application/json", "User-Agent": "EmbeddedVille-Lab/1"}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    if payload is not None:
        body = json.dumps(payload, separators=(",", ":")).encode("utf-8")
        content_type = "application/json"
    if content_type:
        headers["Content-Type"] = content_type
    request = urllib.request.Request(url, data=body, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            return json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as error:
        detail = error.read().decode("utf-8", errors="replace")
        try:
            parsed = json.loads(detail)
            detail = f"{parsed.get('code', error.code)}: {parsed.get('message', detail)}"
        except json.JSONDecodeError:
            pass
        raise LabError(f"EmbeddedVille rejected the request ({error.code}): {detail}") from error
    except urllib.error.URLError as error:
        raise LabError(f"Could not reach EmbeddedVille: {error.reason}") from error


def multipart(manifest_bytes: bytes, archive: bytes) -> tuple[bytes, str]:
    boundary = f"embeddedville-{uuid.uuid4().hex}"
    chunks = [
        f"--{boundary}\r\nContent-Disposition: form-data; name=\"manifest\"\r\nContent-Type: application/json\r\n\r\n".encode(), manifest_bytes,
        f"\r\n--{boundary}\r\nContent-Disposition: form-data; name=\"snapshot\"; filename=\"workspace.zip\"\r\nContent-Type: application/zip\r\n\r\n".encode(), archive,
        f"\r\n--{boundary}--\r\n".encode(),
    ]
    return b"".join(chunks), f"multipart/form-data; boundary={boundary}"


def activity(cfg: dict, activity_id: str) -> dict:
    try:
        return cfg["activities"][activity_id]
    except KeyError as error:
        choices = ", ".join(sorted(cfg["activities"]))
        raise LabError(f"Unknown activity '{activity_id}'. Choose one of: {choices}") from error


def check(cfg: dict, activity_id: str) -> None:
    selected = activity(cfg, activity_id)
    command = selected.get("check")
    if not command:
        raise LabError(f"No local check is configured for {activity_id}.")
    result = subprocess.run(command, cwd=ROOT, shell=True, check=False)
    if result.returncode:
        raise LabError(f"Local check failed with exit code {result.returncode}.")


def submit(cfg: dict, activity_id: str) -> None:
    selected = activity(cfg, activity_id)
    manifest, archive = snapshot(cfg)
    manifest_bytes = canonical_manifest(manifest)
    api_base = os.environ.get("EMBEDDEDVILLE_API_BASE", cfg["apiBase"]).rstrip("/")
    head = run_git("rev-parse", "HEAD")
    base_ref = run_git("describe", "--tags", "--exact-match", "HEAD") or run_git("branch", "--show-current")
    dirty = bool(run_git("status", "--porcelain", "--untracked-files=all"))
    created = request_json(f"{api_base}/workspace-submission-sessions", method="POST", payload={"courseId": selected["courseId"], "activityId": activity_id, "repository": cfg["repository"], "starterVersion": cfg["starterVersion"], "baseRef": base_ref, "headCommit": head, "dirty": dirty, "manifestSha256": hashlib.sha256(manifest_bytes).hexdigest(), "snapshotSha256": hashlib.sha256(archive).hexdigest(), "snapshotBytes": len(archive)})
    print("Approve this exact workspace snapshot in your signed-in browser:")
    print(created["verificationUri"])
    print(f"Code: {created['userCode']}")
    print("Waiting for approval (the code expires in ten minutes)...", flush=True)
    status_url = f"{api_base}/workspace-submission-sessions/{created['id']}/status"
    deadline = time.monotonic() + 600
    while time.monotonic() < deadline:
        state = request_json(status_url, token=created["pollToken"])["status"]
        if state == "approved":
            break
        if state in {"denied", "expired", "consumed"}:
            raise LabError(f"Pairing ended with status: {state}.")
        time.sleep(2)
    else:
        raise LabError("Pairing approval timed out.")
    exchanged = request_json(f"{api_base}/workspace-submission-sessions/{created['id']}/exchange", method="POST", token=created["pollToken"], body=b"")
    body, content_type = multipart(manifest_bytes, archive)
    result = request_json(f"{api_base}/workspace-submission-sessions/{created['id']}/submit", method="POST", token=exchanged["submissionToken"], body=body, content_type=content_type)
    print(f"Submitted immutable revision {result['revision']} (snapshot sha256:{result['snapshotSha256']}).")


def main() -> int:
    parser = argparse.ArgumentParser(prog="./lab")
    subparsers = parser.add_subparsers(dest="command", required=True)
    for command in ("check", "submit"):
        sub = subparsers.add_parser(command)
        sub.add_argument("--activity", required=True)
    args = parser.parse_args()
    cfg = config()
    if args.command == "check":
        check(cfg, args.activity)
    else:
        submit(cfg, args.activity)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (LabError, OSError, json.JSONDecodeError) as error:
        print(f"lab: {error}", file=sys.stderr)
        raise SystemExit(1)
